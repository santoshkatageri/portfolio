# ── Optional: Ghost as the headless article source ─────────────────────────
# Set both values (build time only — e.g. Cloudflare Pages → Settings →
# Environment variables) and Ghost replaces content/articles/*.mdx as the
# source of truth for /writing. Leave unset to use the MDX pipeline.
#
# The Content API key is the public, read-only key from a Ghost Custom
# Integration (Settings → Integrations). NEVER use the Admin API key here.

# GHOST_API_URL=https://ghost.example.com
# GHOST_CONTENT_API_KEY=0123456789abcdef0123456789

# Optional: pin the Content API version (defaults to v5.0)
# GHOST_API_VERSION=v5.0
